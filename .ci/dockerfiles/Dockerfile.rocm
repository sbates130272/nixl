# Copy the full NIXL source tree. Placed last so edits don't bust the cached
# dependency layers above. build-rocm.sh runs meson from the source root (source
# dir = cwd) and later cd's into benchmark/nixlbench, so the whole tree is needed.
COPY --chown="${_UID}":"${_GID}" . /nixl-src

RUN apt-get update && \
    apt-get install -y \
        hwloc \
        libhwloc-dev && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Switch to non-root user
USER ${_LOGIN}

# Set environment variables
ENV HOME=${_HOME}
ENV USER=${_LOGIN}

WORKDIR /nixl-src
RUN /nixl-src/.gitlab/build-rocm.sh ${NIXL_INSTALL_DIR}

# Set working directory
WORKDIR ${_HOME}
