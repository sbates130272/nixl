ARG UBUNTU_CODENAME=noble
ARG BASE_IMAGE=ubuntu:${UBUNTU_CODENAME}

# Skip Infinia Libs

FROM ${BASE_IMAGE}
ARG UBUNTU_CODENAME
ARG UBUNTU_MAJOR_VERSION=24
ARG UBUNTU_MINOR_VERSION=04
ARG ROCM_VERSION=7.14.0

# Build arguments
ARG _UID=148069
ARG _GID=30
ARG _LOGIN=svc-nixl
ARG _GROUP=hardware
ARG _HOME=/home/$_LOGIN
ARG ARCH=x86_64
ARG NIXL_INSTALL_DIR
ARG PRE_INSTALLED_ENV
ARG PRE_INSTALLED_NIXL_ENV
ARG PRE_INSTALLED_UCX_ENV
ARG UCX_VERSION=v1.21.x

# Update package list and install required packages in one layer
RUN apt-get update && \
    apt-get install -y \
        ca-certificates \
        curl \
        gpg \
        kmod \
        python3 \
        python3-pip \
        sudo && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install ROCm from the prerelease multi-arch repo (follows the "new" layout:
# install path /opt/rocm/core-<MAJOR>.<MINOR>, amdrocm-runtime-dev meta-package).
RUN ROCM_MAJOR=$(echo "${ROCM_VERSION}" | cut -d. -f1); \
    ROCM_MINOR=$(echo "${ROCM_VERSION}" | cut -d. -f2); \
    ROCM_INSTALL_PATH="/opt/rocm/core-${ROCM_MAJOR}.${ROCM_MINOR}"; \
    printf 'ROCM_MAJOR=%s\nROCM_MINOR=%s\nROCM_BUILD_TYPE=%s\nROCM_INSTALL_PATH=%s\n' \
        "${ROCM_MAJOR}" "${ROCM_MINOR}" "new" "${ROCM_INSTALL_PATH}" \
        > /etc/rocm-build.env
RUN . /etc/rocm-build.env && \
    echo "deb [arch=amd64 trusted=yes] https://rocm.prereleases.amd.com/packages-multi-arch/ubuntu${UBUNTU_MAJOR_VERSION}${UBUNTU_MINOR_VERSION} stable main" \
        > /etc/apt/sources.list.d/amdrocm-prerelease.list

# Install all build deps prior to running build-rocm.sh
RUN . /etc/rocm-build.env && \
    apt-get update && \
    apt-get install -y \
        amdrocm-runtime-dev${ROCM_MAJOR}.${ROCM_MINOR} \
        build-essential \
        cmake \
        gdb \
        git \
        libasio-dev \
        libgflags-dev \
        libmount-dev \
        libtomlplusplus-dev \
        libaio-dev \
        liburing-dev \
        llvm-dev \
        meson \
        ninja-build \
        pkg-config \
        python3.12-dev \
        python3-pybind11 \
        python3.12-venv && \
    # nixl purposesly reinstalls these deps so they get pulled \
    # from DOCA. For now, just grab the default ones. \
    apt-get -y install \
        libibverbs-dev \
        rdma-core \
        ibverbs-utils \
        libibumad-dev \
        libnuma-dev \
        librdmacm-dev \
        ibverbs-providers && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Mount the AMD root CA as a BuildKit secret (never persisted in any layer).
# Pass --secret id=amd_root_ca,src=<path> at build time when building inside
# the AMD network. Omit it entirely for external/public builds.
RUN --mount=type=secret,id=amd_root_ca,required=false \
    if [ -f /run/secrets/amd_root_ca ] && [ -s /run/secrets/amd_root_ca ]; then \
        cp /run/secrets/amd_root_ca /usr/local/share/ca-certificates/AMDRootCA.crt && \
        update-ca-certificates; \
    fi
RUN pip3 \
        --no-cache-dir \
        install \
        --break-system-packages \
        --cert /etc/ssl/certs/ca-certificates.crt \
        meson \
        meson-python \
        pybind11 \
        patchelf \
        click \
        tabulate \
        auditwheel \
        tomlkit \
        pytest \
        pytest-timeout \
        zmq \
        mpmath \
        typing-extensions \
        sympy \
        numpy \
        networkx \
        MarkupSafe \
        fsspec \
        filelock \
        jinja2 \
        nanobind
RUN pip3 \
        --no-cache-dir \
        install \
        --break-system-packages \
        --cert /etc/ssl/certs/ca-certificates.crt \
        --index-url https://rocm.prereleases.amd.com/whl-multi-arch/ \
        torch==2.11.0+rocm7.14.0rc0
ENV PRE_INSTALLED_ENV=1

# Create group and user in one RUN command to reduce layers
RUN if ! getent group "${_GID}" > /dev/null 2>&1; then \
    groupadd -g "${_GID}" "${_GROUP}"; \
    fi && \
    useradd -u "${_UID}" -g "${_GID}" -m -s /bin/bash "${_LOGIN}" && \
    mkdir -p "${_HOME}" && \
    chown -R "${_UID}":"${_GID}" "${_HOME}"

ARG NIXL_INSTALL_DIR=/opt/nixl
RUN mkdir -p ${NIXL_INSTALL_DIR} && chown -R "${_UID}":"${_GID}" ${NIXL_INSTALL_DIR}

# Configure sudo access
RUN mkdir -p /etc/sudoers.d && \
    echo "${_LOGIN} ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/${_LOGIN} && \
    chmod 440 /etc/sudoers.d/${_LOGIN} && \
    chown root:root /etc/sudoers.d/${_LOGIN}

# Download & Install various other source deps
#
# These env vars are consumed by the dep-build RUN steps below. Values mirror the
# defaults in .gitlab/build.sh. INSTALL_DIR/LIBFABRIC_INSTALL_DIR point at the
# NIXL prefix so build-rocm.sh (run with PRE_INSTALLED_ENV=1) finds them prebuilt.
ENV SUDO=
ENV TMPDIR=/tmp
ENV INSTALL_DIR=${NIXL_INSTALL_DIR}
ENV LIBFABRIC_INSTALL_DIR=${NIXL_INSTALL_DIR}
ENV LIBFABRIC_VERSION=v1.21.0
ENV ABSL_TAG=lts_2025_08_14
ENV GRPC_TAG=v1.73.0
ENV AZURITE_VER=3.35.0
ENV NPROC=16

# HACK for forgotten deps
RUN apt-get update && \
    apt-get install -y \
        autoconf \
        libtool \
        wget && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*
# Skipping source deps as we don't care for the other plugins...

